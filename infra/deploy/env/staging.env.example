# Staging environment (pre-production; same images, smaller sizing) for scripts/deploy/*.sh. Copy to /etc/hinode-staging/production.env,
# chmod 600, owned by the deploy user. Secrets live in files under /etc/hinode-staging/secrets
# (chmod 600); this file only points at them. Never commit filled-in copies.
COMPOSE_PROJECT_NAME=hinode-staging
ENVIRONMENT=staging
SITE_NAME=erp-staging.hinode.example
SITES_RULE=Host(`erp-staging.hinode.example`)

# TLS: "letsencrypt" (frappe_docker compose.https.yaml) or "files" (compose.tls-files.yaml)
TLS_MODE=files
TLS_CERT_DIR=/etc/hinode-staging/tls
LETSENCRYPT_EMAIL=ops@hinode.example

# Immutable application image (scripts/image/build.sh --push ...); never :latest
CUSTOM_IMAGE=registry.hinode.example/hinode/erp
CUSTOM_TAG=0.1.0-REPLACE_WITH_GIT_SHA
PULL_POLICY=always

# Secrets (files)
DB_PASSWORD_SECRETS_FILE=/etc/hinode-staging/secrets/db_root_password
ADMIN_PASSWORD_FILE=/etc/hinode-staging/secrets/admin_password
METRICS_TOKEN_FILE=/etc/hinode-staging/secrets/metrics_token
RESTIC_PASSWORD_FILE=/etc/hinode-staging/secrets/restic_password
GRAFANA_ADMIN_PASSWORD_FILE=/etc/hinode-staging/secrets/grafana_admin_password
MYSQLD_EXPORTER_CNF=/etc/hinode-staging/secrets/mysqld_exporter.cnf

# Off-host, encrypted backups (restic). S3-compatible object storage in another site.
RESTIC_REPOSITORY=s3:https://backup.example.net/hinode-erp-staging
RESTIC_AWS_ACCESS_KEY_ID=REPLACE
RESTIC_AWS_SECRET_ACCESS_KEY=REPLACE
# job schedules are UTC (the cron container has no time zone): 02:30 JST nightly, Sunday 04:30 JST
BACKUP_SCHEDULE=0 30 17 * * *
RESTORE_DRILL_SCHEDULE=0 30 19 * * 6
# binary log shipping for point-in-time recovery (ops/runbooks/backup-restore.md); off disables
BINLOG_SCHEDULE=0 */5 * * * *

# Monitoring stack (compose.monitoring.yaml): 1 = deploy it
MONITORING=1

# Sizing for ~150 concurrent internal + partner users (see ops/performance/)
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
BACKEND_MEM_LIMIT=3g
BACKEND_CPUS=4
WORKER_MEM_LIMIT=2g
DB_BUFFER_POOL=2G
DB_MEM_LIMIT=4g
DB_CPUS=2
DB_MAX_CONNECTIONS=300
