# Reference / demo environment: the "-reference" image (includes automotive_seed) and a
# site loaded with the synthetic Hinode dataset. Not for real data. Single host, no
# public exposure (publish on 127.0.0.1 behind the VPN or an SSH tunnel).
COMPOSE_PROJECT_NAME=hinode-reference
ENVIRONMENT=reference
SITE_NAME=erp-reference.hinode.example
SITES_RULE=Host(`erp-reference.hinode.example`)
TLS_MODE=files
TLS_CERT_DIR=/etc/hinode-reference/tls
CUSTOM_IMAGE=toyota-erp/erp
CUSTOM_TAG=0.1.0-reference
PULL_POLICY=never
HTTP_PUBLISH_PORT=127.0.0.1:18080
HTTPS_PUBLISH_PORT=127.0.0.1:18443
DB_PASSWORD_SECRETS_FILE=/etc/hinode-reference/secrets/db_root_password
ADMIN_PASSWORD_FILE=/etc/hinode-reference/secrets/admin_password
METRICS_TOKEN_FILE=/etc/hinode-reference/secrets/metrics_token
RESTIC_PASSWORD_FILE=/etc/hinode-reference/secrets/restic_password
RESTIC_REPOSITORY=/srv/hinode-reference/restic
SEED_PROFILE=standard
MONITORING=0
GUNICORN_WORKERS=4
BACKEND_MEM_LIMIT=3g
DB_BUFFER_POOL=2G
DB_MEM_LIMIT=4g
