{
 "uid": "hinode-erp-ops",
 "title": "Hinode ERP \u2014 Operations",
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "tags": [
  "erp"
 ],
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Queue depth",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (queue) (erp_queue_jobs)",
     "legendFormat": "{{queue}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Failed jobs",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (queue) (erp_queue_failed_jobs)",
     "legendFormat": "{{queue}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Outbox",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (status) (erp_outbox_messages)",
     "legendFormat": "{{status}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Inbox problems",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (status) (erp_inbox_messages)",
     "legendFormat": "{{status}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Hours since last backup",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "h"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(time() - max(erp_backup_last_success_timestamp_seconds)) / 3600",
     "legendFormat": "backup age"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Unsealed audit events",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(erp_audit_unsealed_events)",
     "legendFormat": "unsealed"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Pending approvals / open work",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(erp_approvals_pending) or max(erp_match_exceptions_open)",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Quality holds and Andon",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(erp_quality_holds_active) or max(erp_andon_open)",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "MariaDB connections",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "mysql_global_status_threads_connected",
     "legendFormat": "threads"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Redis memory",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "redis_memory_used_bytes",
     "legendFormat": "{{instance}}"
    }
   ]
  }
 ]
}
