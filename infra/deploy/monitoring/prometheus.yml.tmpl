# Scrape targets for the Hinode ERP stack (compose.monitoring.yaml). Template: scripts/deploy/compose.sh
# renders ${SITE_NAME} into monitoring/prometheus.rendered.yml (Prometheus has no env expansion).
global:
  scrape_interval: 30s
  evaluation_interval: 30s

rule_files: [/etc/prometheus/alerts.yml]

alerting:
  alertmanagers:
    - static_configs: [{ targets: ["alertmanager:9093"] }]

scrape_configs:
  # automotive_core.ops.health.metrics: queues, outbox/inbox, audit sealing, backups, work queues
  - job_name: erp
    metrics_path: /api/method/automotive_core.ops.health.metrics
    # the token in its own header: Frappe refuses an Authorization header that is not a login
    http_headers:
      X-Frappe-Site-Name:
        values: ["${SITE_NAME}"]
      X-Hinode-Metrics-Token:
        files: [/etc/prometheus/erp-metrics-token]
    static_configs: [{ targets: ["backend:8000"] }]

  - job_name: mariadb
    static_configs: [{ targets: ["mysqld-exporter:9104"] }]

  - job_name: redis
    static_configs: [{ targets: ["redis-exporter:9121"] }]

  - job_name: node
    static_configs: [{ targets: ["node-exporter:9100"] }]
